# 기본: 줄바꿈은 저장소에 LF로 정규화, 체크아웃 시 OS 기본값
* text=auto

# Unity YAML 에셋 — 텍스트로 취급 (Smart Merge 사용 가능)
*.unity          text eol=lf
*.prefab         text eol=lf
*.asset          text eol=lf
*.meta           text eol=lf
*.mat            text eol=lf
*.anim           text eol=lf
*.controller     text eol=lf
*.physicsMaterial2D text eol=lf
*.scenetemplate  text eol=lf

# 소스·문서
*.cs             text eol=lf diff=csharp
*.md             text eol=lf
*.json           text eol=lf
*.inputactions   text eol=lf

# 바이너리 — 병합/diff 시도 금지
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.psd            binary
*.aseprite       binary
*.wav            binary
*.mp3            binary
*.ogg            binary
*.ttf            binary
*.otf            binary
*.fbx            binary
*.unitypackage   binary
