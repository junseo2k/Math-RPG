%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 322b988d24e2a674f92fa2f0eeda5792, type: 3}
  m_Name: ChapterFour
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.ChapterFourDefinition
  pages:
  - title: "\uBCC0\uC9C8\uB41C \uB9C8\uB825"
    body: "\uD558\uB298\uC5D0 \uB0AF\uC120 \uADE0\uC5F4\uC774 \uBC88\uC84C\uB2E4.
      \uB9C8\uB825\uC774 \uD750\uB974\uB294 \uBC29\uD5A5\uC774 \uB4A4\uD2C0\uB838\uB2E4.\n\uC775\uC219\uD55C
      \uC2DD\uC73C\uB85C\uB294 \uD750\uB984\uC870\uCC28 \uC77D\uC744 \uC218 \uC5C6\uB294
      \uAD34\uBB3C\uB4E4\uC774 \uAE38\uC744 \uB36E\uC5C8\uB2E4.\n\n\uC0AC\uB78C\uB4E4\uC774
      \uD53C\uC2E0\uD55C \uACF3\uC5D0\uB3C4 \uC7AC\uC559\uC740 \uB530\uB77C\uC654\uB2E4.
      \uB354\uB294 \uC548\uC804\uD55C \uB9C8\uC744\uC774 \uC5C6\uC5C8\uB2E4."
    action: "\uD1A0\uBC8C\uB300\uC758 \uC18C\uC2DD\uC744 \uB4E3\uB294\uB2E4"
  - title: "\uC0C8 \uCD1D\uC0AC\uB839\uAD00"
    body: "\uC655\uC758 \uC778\uC7A5\uC744 \uBC1B\uC740 \uCE5C\uAD6C\uB294 \uCD1D\uC0AC\uB839\uAD00\uC774
      \uB418\uC5C8\uB2E4.\n\uB77C\uC774\uBC8C2: \uB0B4\uAC00 \uC55E\uC5D0 \uC120\uB2E4.
      \uB300\uC5F4\uC744 \uC720\uC9C0\uD574.\n\n\uADF8\uB294 \uBCD1\uC0AC\uB4E4\uC744
      \uC774\uB04C\uACE0 \uC7AC\uC559\uC744 \uD5A5\uD574 \uB098\uC544\uAC14\uB2E4."
    action: "\uD1A0\uBC8C\uC758 \uD589\uBC29"
  - title: "\uCC98\uC74C\uC73C\uB85C \uD754\uB4E4\uB9B0 \uC190"
    body: "\uBCD1\uC0AC\uB4E4\uC758 \uC2DC\uC120\uC774 \uD55C \uC0AC\uB78C\uC758
      \uC190\uB05D\uC5D0 \uBAA8\uC600\uB2E4.\n\uD55C \uBC88\uC758 \uC2E4\uC218\uAC00
      \uBAA8\uB450\uB97C \uC8FD\uC77C \uC218 \uC788\uB2E4\uB294 \uC0DD\uAC01\uC5D0,
      \uC775\uC219\uD55C \uC2DD\uC774 \uB04A\uACBC\uB2E4.\n\uB77C\uC774\uBC8C2: \u2026\uBB3C\uB7EC\uC11C!
      \uBD80\uC0C1\uC790\uBD80\uD130 \uB370\uB9AC\uACE0 \uB098\uAC00!\n\n\uD1A0\uBC8C\uB300\uB294
      \uB3CC\uC544\uC654\uB2E4. \uC7AC\uC559\uC740 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    action: "\uD55C\uD3B8, \uAE38\uC5D0\uC11C \uBA40\uC5B4\uC9C4 \uACF3"
  - title: "\uC544\uBB34\uB3C4 \uC5C6\uB294 \uACF3"
    body: "\uC8FC\uC778\uACF5\uC740 \uBB34\uB108\uC9C4 \uB2F4\uBCBC\uB77D \uC544\uB798\uC5D0
      \uD640\uB85C \uC549\uC544 \uC788\uC5C8\uB2E4.\n\uAC80\uC744 \uC7A1\uC744 \uC774\uC720\uB3C4,
      \uB3CC\uC544\uAC08 \uACF3\uB3C4 \uB5A0\uC624\uB974\uC9C0 \uC54A\uC558\uB2E4.\n\n\uD488\uC18D\uC5D0\uC11C
      \uAD6C\uACA8\uC9C4 \uBD09\uD22C\uAC00 \uC190\uB05D\uC5D0 \uB2FF\uC558\uB2E4.
      \uC544\uC9C1 \uB72F\uC9C0 \uBABB\uD55C \uB2F5\uC7A5\uC774\uC5C8\uB2E4."
    action: "\uB2F5\uC7A5\uC744 \uB72F\uB294\uB2E4"
  - title: "\uBD80\uBAA8\uB2D8\uC758 \uB2F5\uC7A5"
    body: "\u201C\uC774 \uBCBC\uC2AC\uC744 \uC5BB\uC73C\uBA74 \uB108\uB3C4 \uC6B0\uB9AC\uB3C4
      \uB2E4 \uD3B8\uD574\uC9C8 \uAC70\uB2E4.\n\uC6B0\uB9B4 \uC704\uD574\uC11C\uB77C\uB3C4
      \uBC84\uD168\uB2E4\uC624.\u201D\n\n\uC8FC\uC778\uACF5\uC740 \uAC19\uC740 \uBB38\uC7A5\uC744
      \uC624\uB798 \uBC14\uB77C\uBCF4\uC558\uB2E4.\n\uC885\uC774\uB97C \uC954 \uB450
      \uC190\uC774 \uCC9C\uCC9C\uD788 \uBC8C\uC5B4\uC84C\uB2E4."
    action: "\uB2F5\uC7A5\uC744 \uCC22\uB294\uB2E4"
  - title: "\uCC22\uC5B4\uC9C4 \uB2F5\uC7A5"
    body: 
    action: "\uB2E4\uAC00\uC624\uB294 \uBC1C\uC18C\uB9AC"
  - title: "\uCC3E\uC544\uC628 \uAC00\uC871"
    body: "\uCC22\uC5B4\uC9C4 \uC885\uC774\uAC00 \uBC1C\uCE58\uC5D0 \uD769\uC5B4\uC84C\uB2E4.
      \uB204\uAD70\uAC00 \uAC78\uC74C\uC744 \uBA48\uCDC4\uB2E4.\n\uB77C\uC774\uBC8C1:
      \u2026\uC5EC\uAE30 \uC788\uC5C8\uAD6C\uB098. \uC5BC\uB9C8\uB098 \uCC3E\uC544\uB2E4\uB154\uB294\uC9C0
      \uC54C\uC544?\n\n\uC8FC\uC778\uACF5\uC740 \uACE0\uAC1C\uB97C \uB4E4\uC9C0 \uC54A\uC558\uB2E4.\n\uB77C\uC774\uBC8C1\uC740
      \uC8FC\uC778\uACF5 \uC55E\uC5D0 \uBA48\uCDB0 \uC130\uB2E4."
    action: "\uB77C\uC774\uBC8C\uC744 \uBC14\uB77C\uBCF8\uB2E4"
  - title: "\uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uB3C4\uBC1C"
    body: "\uB77C\uC774\uBC8C1: \uC77C\uC5B4\uB098. \uB0A0 \uC4F0\uB7EC\uB728\uB824\uBD10.\n\uADF8\uB7EC\uC9C0
      \uC54A\uC73C\uBA74 \uD3EC\uAE30\uD558\uC9C0\uB3C4 \uBABB\uD574.\n\n\uC8FC\uC778\uACF5\uC758
      \uC2DC\uC120\uC740 \uBC14\uB2E5\uC5D0 \uBA38\uBB3C\uB800\uB2E4.\n\uAC80\uC744
      \uB4E4\uC5B4\uC57C \uD55C\uB2E4\uB294 \uC0DD\uAC01\uC870\uCC28 \uB05D\uAE4C\uC9C0
      \uC774\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    action: "\uAC80\uC5D0 \uC190\uC744 \uBED7\uB294\uB2E4"
  - title: "\uC77C\uC5B4\uB098\uC9C0 \uBABB\uD55C \uC0AC\uB78C"
    body: "\uC190\uC774 \uC62C\uB77C\uAC00\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uAC00\uC624\uB294
      \uAC80\uC5D0\uB3C4 \uBAB8\uC774 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4.\n\uB77C\uC774\uBC8C1\uC740
      \uAE09\uD788 \uAC80\uC744 \uAC70\uB480\uC9C0\uB9CC, \uC8FC\uC778\uACF5\uC740
      \uADF8\uB300\uB85C \uBB34\uB108\uC84C\uB2E4.\n\n\uC2F8\uC6C0\uC740 \uC2DC\uC791\uC870\uCC28
      \uB418\uC9C0 \uC54A\uC558\uB2E4.\n\uBC1C\uCE58\uC5D0 \uD769\uC5B4\uC9C4 \uB2F5\uC7A5
      \uC870\uAC01\uC774 \uBC14\uB78C\uC5D0 \uBC00\uB838\uB2E4."
    action: "\uACE0\uAC1C\uB97C \uC219\uC778 \uCC44"
  - title: "\uB2E4\uC2DC, \uADF8 \uB9D0"
    body: "\uB77C\uC774\uBC8C1: \u2026\uC774\uB807\uAC8C \uC788\uC744 \uAC70\uC57C?\n\n\uC544\uBB34
      \uB300\uB2F5\uB3C4 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uB2E4. \uB77C\uC774\uBC8C1\uC774
      \uAC00\uAE4C\uC774 \uBAB8\uC744 \uB0AE\uCDC4\uB2E4.\n\n\uB77C\uC774\uBC8C1:
      \u2026\uBD80\uBAA8\uB2D8\uC774 \uAC71\uC815\uD558\uC2E4 \uAC70\uC57C."
    action: "\uACE0\uAC1C\uB97C \uB4E0\uB2E4"
  - title: "\uCC98\uC74C\uC73C\uB85C \uC3DF\uC544\uB0B8 \uB9D0"
    body: "\uC8FC\uC778\uACF5: \uADF8\uB534 \uAC70 \uC54C \uBC14 \uC544\uB2C8\uC57C!\n\uC544\uBB34\uB3C4
      \uB0A0 \uBD10\uC900 \uC801 \uC5C6\uC796\uC544.\n\uB2E4\uB4E4 \uB0B4\uAC00 \uBB58
      \uD574\uB0B4\uB294\uC9C0\uB9CC \uC2E0\uACBD \uC37C\uC9C0, \uB098\uB97C \uBCF8
      \uC801\uC740 \uC5C6\uC5C8\uC5B4!\n\n\uB77C\uC774\uBC8C1\uC740 \uB9D0\uC744
      \uC783\uC5C8\uB2E4. \uC8FC\uC778\uACF5\uC758 \uBAA9\uC18C\uB9AC\uB9CC \uB610\uB837\uD558\uAC8C
      \uB0A8\uC558\uB2E4."
    action: "\uC3DF\uC544\uC9C0\uB294 \uB9C8\uB825"
  - title: "\uBB34\uB108\uC9C0\uB294 \uACBD\uACC4"
    body: "\uB8EC \uC7A5\uAC11\uC758 \uD2C8\uC73C\uB85C \uB9C8\uB825\uC774 \uC0C8\uC5B4
      \uB098\uC654\uB2E4. \uC190\uB05D\uC758 \uC724\uACFD\uC774 \uD750\uB824\uC84C\uB2E4.\n\uBD84\uB178\uAC00
      \uCEE4\uC9C8\uC218\uB85D \uBAB8\uC740 \uB0AF\uC120 \uBB34\uC5B8\uAC00\uB85C
      \uBC14\uB00C\uB824 \uD588\uB2E4.\n\uB77C\uC774\uBC8C1: \uC190\uC774\u2026!
      \uC7A0\uAE50, \uB0B4 \uB9D0 \uC880 \uB4E4\uC5B4!\n\n\uBAA9\uC18C\uB9AC\uAC00
      \uBA40\uC5B4\uC9C0\uACE0, \uBC1C\uBC11\uC758 \uAC10\uAC01\uC774 \uC0AC\uB77C\uC84C\uB2E4."
    action: "\uC548\uCABD\uC758 \uBAA9\uC18C\uB9AC"
  - title: "\uB610 \uB2E4\uB978 \uB098"
    body: "\uC815\uB839: \uB098\uB294 \uB2E4\uB978 \uAC00\uB2A5\uC138\uACC4\uC5D0\uC11C
      \uC628, \uB610 \uB2E4\uB978 \uB108\uC57C.\n\uB124 \uBBF8\uB798\uAC00 \uC544\uB2C8\uB77C,
      \uB2E4\uB978 \uC138\uACC4\uB97C \uC0B4\uC558\uB358 \uB098.\n\n\uB208\uC744
      \uB728\uC790 \uC815\uB839\uC774 \uB9C8\uC8FC \uC11C \uC788\uC5C8\uB2E4.\n\uADF8
      \uB108\uBA38\uB85C \uC790\uAE30 \uC790\uC2E0\uACFC \uB2EE\uC740 \uC724\uACFD\uC774
      \uACB9\uCCD0 \uBCF4\uC600\uB2E4."
    action: "\uC815\uB839\uC758 \uC774\uC57C\uAE30\uB97C \uB4E3\uB294\uB2E4"
  - title: "\uB3CC\uC544\uAC08 \uC218 \uC5C6\uB358 \uC2DC\uAC04"
    body: "\uC815\uB839: \uB098\uB3C4 \uADF8 \uC790\uB9AC\uC5D0 \uC624\uB974\uC9C0
      \uBABB\uD588\uC5B4. \uB4A4\uB2A6\uAC8C \uAE68\uB2EC\uC558\uC744 \uB550\n\uC2A4\uBB3C\uC14B\uC744
      \uB118\uACA8 \uB2E4\uC2DC \uB3C4\uC804\uD560 \uC218\uB3C4 \uC5C6\uC5C8\uC9C0.\n\uC7AC\uB09C\uC758
      \uC794\uC7AC\uAC00 \uB0A0 \uC815\uB839\uC73C\uB85C, \uB0A8\uC740 \uC2DC\uAC04\uC758
      \uD798\uC774 \uC774 \uC138\uACC4\uB85C \uBCF4\uB0C8\uC5B4.\n\n\uCC98\uC74C\uBD80\uD130
      \uC54C\uACE0 \uC788\uC5C8\uC5B4. \uB124\uAC00 \uBB34\uB108\uC9C0\uB294 \uBAA8\uC2B5\uB3C4,
      \uB0AF\uC124\uC9C0 \uC54A\uC558\uC5B4."
    action: "\uB9D0\uC5C6\uC774 \uB4E3\uB294\uB2E4"
  - title: "\uB108\uB97C \uC704\uD574\uC11C"
    body: "\uC815\uB839: \u2026\uB108, \uACC4\uC18D \uBD80\uBAA8\uB2D8 \uB73B\uB300\uB85C\uB9CC
      \uC0B4\uC544\uC654\uC796\uC544.\n\uADFC\uB370 \uB10C \uB108\uC796\uC544. \uBD80\uBAA8\uB2D8\uC744
      \uC704\uD574\uC11C\uAC00 \uC544\uB2C8\uB77C, \uB108\uB97C \uC704\uD574\uC11C
      \uC0AC\uB294 \uAC70\uC57C.\n\uCD1D\uC0AC\uB839\uAD00\uC774 \uBABB \uB418\uBA74
      \uBB50 \uC5B4\uB54C. \uB124\uAC00 \uC798\uD558\uB294 \uAC78 \uD558\uBA74\uC11C
      \uC0B4\uBA74 \uB418\uC796\uC544.\n\n\uB0B4\uAC00 \uB193\uCE5C \uAC74 \uADF8
      \uC790\uB9AC\uAC00 \uC544\uB2C8\uC5C8\uC5B4. \uB0B4\uAC00 \uBB58 \uC88B\uC544\uD558\uB294\uC9C0\uB3C4
      \uBAB0\uB790\uB358 \uAC70\uC57C."
    action: "\uC815\uB839\uC774 \uC870\uC6A9\uD788 \uBB3B\uB294\uB2E4"
  - title: "\uAC00\uC7A5 \uCC2C\uB780\uD588\uB358 \uC21C\uAC04"
    body: "\uC815\uB839: \u2026\uB124 \uC778\uC0DD\uC5D0\uC11C \uAC00\uC7A5 \uCC2C\uB780\uD588\uB358
      \uB54C\uB294 \uC5B8\uC81C\uC57C?\n\n\n\uC544\uBB34 \uB9D0\uB3C4 \uB5A0\uC624\uB974\uC9C0
      \uC54A\uC558\uB2E4.\n\uCE68\uBB35 \uC18D\uC5D0\uC11C, \uC624\uB798 \uC78A\uACE0
      \uC788\uB358 \uAC10\uAC01 \uD558\uB098\uAC00 \uB0A8\uC558\uB2E4."
    action: "\uADF8 \uAC10\uAC01\uC744 \uB530\uB77C\uAC04\uB2E4"
  - title: "\uC544\uBB34\uB3C4 \uBCF4\uC9C0 \uC54A\uB358 \uB0A0"
    body: "\uD6C8\uB828\uC18C \uD55C\uCABD\uC5D0\uC11C, \uAC19\uC740 \uC2DD\uC744
      \uBA87 \uBC88\uC774\uB098 \uC9C0\uC6B0\uACE0 \uB2E4\uC2DC \uC37C\uB2E4.\n\uD55C
      \uC904\uC774 \uB2E4\uC74C \uC904\uB85C \uC774\uC5B4\uC84C\uACE0, \uB9C8\uCE68\uB0B4
      \uB2F5\uC774 \uB9DE\uC544\uB5A8\uC5B4\uC84C\uB2E4.\n\uC8FC\uC778\uACF5: \u2026\uB410\uB2E4.\n\n\uCE6D\uCC2C\uD560
      \uC0AC\uB78C\uB3C4 \uC5C6\uC5C8\uB2E4. \uADF8\uB7F0\uB370 \uC6C3\uC74C\uC774
      \uB0AC\uB2E4. \uADF8\uC800 \uB0B4\uAC00 \uD480\uC5B4\uB0C8\uC73C\uB2C8\uAE4C."
    action: "\uADF8 \uC21C\uAC04\uC744 \uBD99\uC7A1\uB294\uB2E4"
  - title: "\uB0B4 \uC190\uC73C\uB85C"
    body: "\uC8FC\uC778\uACF5\uC740 \uADF8\uB54C\uC758 \uAC10\uAC01\uC744 \uB193\uC9C0
      \uC54A\uACE0 \uCC9C\uCC9C\uD788 \uC228\uC744 \uACE8\uB790\uB2E4.\n\uD769\uC5B4\uC9C0\uB358
      \uC190\uB05D\uC774 \uB3CC\uC544\uC654\uB2E4. \uB9C8\uB825\uC774 \uC7A5\uAC11
      \uC548\uC73C\uB85C \uC7A6\uC544\uB4E4\uC5C8\uB2E4.\n\n\uB208\uC55E\uC5D0 \uBB34\uB108\uC9C4
      \uAE38\uACFC \uB77C\uC774\uBC8C1\uC774 \uB2E4\uC2DC \uBCF4\uC600\uB2E4.\n\uC8FC\uC778\uACF5\uC740
      \uC628\uC804\uD55C \uC790\uAE30 \uC190\uC744 \uD3B4 \uBCF4\uC558\uB2E4."
    action: "\uC2A4\uC2A4\uB85C \uC77C\uC5B4\uC120\uB2E4"
  - title: "\uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uAC83"
    body: "\uC8FC\uC778\uACF5: \uB09C\u2026 \uD480\uB838\uC744 \uB54C\uAC00 \uC88B\uC558\uC5B4.
      \uB0B4 \uC190\uC73C\uB85C \uD574\uB0C8\uC744 \uB54C.\n\uC2F8\uC6B0\uACE0, \uC0DD\uAC01\uD558\uACE0,
      \uB2E4\uC2DC \uD574\uBCF4\uB294 \uAC8C.\n\n\uC8FC\uC778\uACF5\uC740 \uC790\uAE30
      \uC758\uC9C0\uB85C \uAC80\uC744 \uC9D1\uC5B4 \uB4E4\uC5C8\uB2E4.\n\uC8FC\uC778\uACF5:
      \uB2E4\uC2DC \uAC00\uBCFC\uAC8C. \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uD558\uACE0
      \uC2F6\uC5B4\uC11C\uC57C."
