  m_Name: HumanClimax
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.HumanClimaxDefinition
  bossName: "\uAC80\uC740 \uBC94\uB78C"
  letter: "\uCC3D\uACE0\uC9C0\uAE30: \uB108\uC5D0\uAC8C \uC628 \uB2F5\uC7A5\uC774\uC57C.
    \uBA3C \uAE38\uC744 \uB3CC\uC544 \uB3C4\uCC29\uD588\uC5B4.\n\n\uBD09\uD22C\uC5D0\uB294
    \uC775\uC219\uD55C \uBD80\uBAA8\uB2D8\uC758 \uAE00\uC528\uAC00 \uC801\uD600 \uC788\uC5C8\uB2E4.\n\uC8FC\uC778\uACF5\uC740
    \uBD09\uD22C \uB05D\uC5D0 \uC190\uC744 \uB314\uB2E4.\n\n\uC815\uB839: \uC774\uC81C
    \uC7A0\uAE50 \uC77D\uC5B4\uB3C4\u2026"
  disaster: "\uB545\uC774 \uC6B8\uB838\uB2E4. \uC232 \uCABD\uC5D0\uC11C \uC9D9\uC740
    \uB369\uC5B4\uB9AC\uAC00 \uBC00\uB824\uC654\uB2E4.\n\uC8FC\uBBFC: \uC608\uC5B8\uC758
    \uC7AC\uB09C\uC774\uC57C! \uBAA8\uB450 \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00!\n\n\uC8FC\uC778\uACF5\uC740
    \uB72F\uC9C0 \uBABB\uD55C \uB2F5\uC7A5\uC744 \uD488\uC5D0 \uB123\uC5C8\uB2E4.\n\uC8FC\uC778\uACF5:
    \uC800 \uC0C9\u2026 \uC655\uC774 \uB9D0\uD55C \uAC83\uACFC \uAC19\uC544.\n\uC815\uB839:
    \uC55E\uC758 \uD750\uB984\uBD80\uD130 \uBCF4\uC790. \uB0B4\uAC00 \uACC1\uC5D0
    \uC788\uC744\uAC8C."
  victory: "\uAC80\uC740 \uB369\uC5B4\uB9AC\uAC00 \uD769\uC5B4\uC9C4 \uC790\uB9AC\uC5D0
    \uC655\uC758 \uC778\uC7A5\uC774 \uB0A8\uC558\uB2E4.\n\n\uC8FC\uBBFC: \uC778\uC7A5\uC774\uC57C!
    \uC7AC\uB09C\uC744 \uB9C9\uACE0 \uC778\uC7A5\uAE4C\uC9C0 \uCC3E\uC558\uC5B4!\n\uCC3D\uACE0\uC9C0\uAE30:
    \uC62C\uD574 \uCD1D\uC0AC\uB839\uAD00\uC740 \uB124\uAC00 \uB418\uACA0\uAD6C\uB098.\n\n\uC8FC\uC778\uACF5:
    \uC774\uC81C\u2026 \uB3CC\uC544\uAC08 \uC218 \uC788\uACA0\uC9C0.\n\uD488\uC18D\uC758
    \uB2F5\uC7A5\uC740 \uC5EC\uC804\uD788 \uB72F\uC9C0 \uC54A\uC740 \uCC44\uC600\uB2E4."
