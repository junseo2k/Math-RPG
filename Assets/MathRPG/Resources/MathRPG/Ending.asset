%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aeb8bae46fd924a42a577ee54f0f7c0c, type: 3}
  m_Name: Ending
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.EndingDefinition
  pages:
  - title: "\uB9C8\uCE68\uB0B4 \uC5BB\uC740 \uC790\uB9AC"
    body: "\uC7AC\uC559\uC774 \uC0AC\uB77C\uC9C4 \uB4A4, \uC8FC\uC778\uACF5\uC740
      \uC655\uAD81\uC73C\uB85C \uBD88\uB824 \uAC14\uB2E4.\n\uC655\uC740 \uACF5\uC801\uC744
      \uC778\uC815\uD558\uACE0 \uC8FC\uC778\uACF5\uC5D0\uAC8C \uCD1D\uC0AC\uB839\uAD00\uC758
      \uBCBC\uC2AC\uC744 \uB0B4\uB838\uB2E4.\n\n\uC624\uB7AB\uB3D9\uC548 \uBC14\uB77C\uB358
      \uB9D0\uC774\uC5C8\uB2E4. \uC8FC\uC778\uACF5\uC740 \uC784\uBA85\uC7A5\uC744
      \uB450 \uC190\uC73C\uB85C \uBC1B\uC558\uB2E4.\n\uBC15\uC218 \uC18C\uB9AC\uAC00
      \uC6B8\uB838\uC9C0\uB9CC, \uB9C8\uC74C \uD55C\uCABD\uC5D0\uB294 \uC870\uC6A9\uD55C
      \uBE48\uC790\uB9AC\uAC00 \uB0A8\uC558\uB2E4."
    action: "\uAC00\uC871\uC5D0\uAC8C \uB3CC\uC544\uAC04\uB2E4"
    backdrop: {r: 0.2, g: 0.18, b: 0.25, a: 1}
    minimumHold: 0.8
  - title: "\uB3CC\uC544\uC628 \uC0AC\uB78C"
    body: "\uC9D1 \uC55E\uC5D0\uB294 \uAC00\uC871\uB4E4\uC774 \uC11C \uC788\uC5C8\uB2E4.
      \uC5B4\uBA38\uB2C8\uAC00 \uBA3C\uC800 \uB2EC\uB824\uC640 \uC8FC\uC778\uACF5\uC744
      \uC548\uC558\uB2E4.\n\uC5B4\uBA38\uB2C8: \u2026\uB3CC\uC544\uC654\uAD6C\uB098.\n\uC544\uBC84\uC9C0\uB294
      \uC784\uBA85\uC7A5\uC744 \uBCF4\uB2E4\uAC00, \uB2E4\uC2DC \uC8FC\uC778\uACF5\uC758
      \uC5BC\uAD74\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4.\n\uC544\uBC84\uC9C0: \uACE0\uC0DD\uD588\uB2E4.
      \uC548\uC73C\uB85C \uB4E4\uC5B4\uC624\uC790.\n\n\uC8FC\uC778\uACF5: \uC800,
      \uBCBC\uC2AC\uC744 \uBC1B\uC558\uC5B4\uC694. \uADF8\uB798\uB3C4 \uC55E\uC73C\uB85C\uB294
      \uC81C\uAC00 \uC88B\uC544\uD558\uB294 \uAC83\uB3C4 \uD558\uBA74\uC11C \uC0B4\uACE0
      \uC2F6\uC5B4\uC694.\n\uC7A0\uC2DC \uCE68\uBB35\uC774 \uD758\uB800\uB2E4. \uAC00\uC871\uB4E4\uC740
      \uD568\uAED8 \uC9D1 \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC14\uB2E4."
    action: "\uADF8 \uB4A4\uC758 \uC774\uC57C\uAE30"
    backdrop: {r: 0.25, g: 0.2, b: 0.16, a: 1}
    minimumHold: 0.8
  - title: "\uC655\uAD81\uC5D0 \uB0A8\uC740 \uBD88\uC548"
    body: "\uC655: \uB2E4\uC74C \uC7AC\uB09C\uC774 \uC624\uBA74, \uADF8\uB54C\uB3C4
      \uB9C9\uC544\uB0BC \uC218 \uC788\uACA0\uB294\uAC00.\n\uC2E0\uD558: \uC0AC\uB78C\uB4E4\uC740
      \uD568\uAED8 \uC2F8\uC6B0\uB294 \uBC95\uC744 \uBC30\uC6E0\uC2B5\uB2C8\uB2E4.
      \uC655\uAD6D\uC740 \uC804\uBCF4\uB2E4 \uAC15\uD574\uC84C\uC2B5\uB2C8\uB2E4.\n\n\uC5BC\uB9C8
      \uB4A4, \uC655\uBA85\uC73C\uB85C \uC791\uC131\uB41C \uBB38\uC11C\uB4E4\uC774
      \uC138\uC0C1\uC5D0 \uACF5\uAC1C\uB418\uC5C8\uB2E4.\n\uC778\uC7A5 \uBD84\uC2E4
      \uACF5\uD45C\uBD80\uD130 \uC778\uAC04 \uB9C8\uC744\uC758 \uC7AC\uB09C\uAE4C\uC9C0,
      \uC655\uC774 \uAFB8\uBBFC \uC77C\uC774\uC5C8\uB2E4.\n\uC18C\uC2DD\uC740 \uB9C8\uC744\uC744
      \uAC74\uB108 \uD37C\uC84C\uB2E4. \uC0AC\uB78C\uB4E4\uC740 \uADF8\uB3D9\uC548\uC758
      \uC77C\uC744 \uB2E4\uC2DC \uC774\uC57C\uAE30\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
    action: "\uC775\uC219\uD55C \uC77C\uC0C1\uC73C\uB85C"
    backdrop: {r: 0.13, g: 0.16, b: 0.22, a: 1}
    minimumHold: 0.8
  - title: "\uB77C\uC774\uBC8C1\uC758 \uC544\uCE68"
    body: "\uB77C\uC774\uBC8C1\uC740 \uC77C\uC0C1\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4.\n\uC544\uCE68\uC5D0\uB294
      \uAC80\uC744 \uC190\uC9C8\uD558\uACE0, \uBC00\uB9B0 \uC77C\uC744 \uB05D\uB0B4\uACE0,
      \uC775\uC219\uD55C \uAE38\uC744 \uAC78\uC5C8\uB2E4.\n\n\uBB38\uB4DD \uC8FC\uC778\uACF5\uC774
      \uC81C \uBC1C\uB85C \uC77C\uC5B4\uC11C\uB358 \uBAA8\uC2B5\uC774 \uB5A0\uC62C\uB790\uB2E4.\n\uB77C\uC774\uBC8C1:
      \u2026\uC774\uC81C\uB294 \uC54C\uC544\uC11C \uAC00\uACA0\uC9C0.\n\uADF8\uB294
      \uC791\uAC8C \uC6C3\uACE0 \uB2E4\uC2DC \uD558\uB358 \uC77C\uC744 \uC774\uC5C8\uB2E4."
    action: "\uD6C8\uB828\uC7A5\uC73C\uB85C"
    backdrop: {r: 0.19, g: 0.26, b: 0.22, a: 1}
    minimumHold: 0.8
  - title: "\uB77C\uC774\uBC8C2\uC758 \uD6C8\uB828\uC7A5"
    body: "\uB77C\uC774\uBC8C2\uB294 \uBCD1\uC0AC\uB4E4\uACFC \uD568\uAED8 \uD6C8\uB828\uC7A5\uC5D0
      \uC11C \uC788\uC5C8\uB2E4.\n\uB77C\uC774\uBC8C2: \uAE09\uD558\uAC8C \uD558\uC9C0
      \uB9C8. \uC2DD\uC744 \uC544\uB294 \uAC83\uACFC \uC190\uC73C\uB85C \uD574\uB0B4\uB294
      \uAC74 \uB2E4\uB974\uB2C8\uAE4C.\n\n\uD55C \uBCD1\uC0AC\uC758 \uB8EC\uC774
      \uB04A\uAE30\uC790, \uADF8\uB294 \uC606\uC73C\uB85C \uB2E4\uAC00\uAC00 \uAC19\uC740
      \uC790\uC138\uB97C \uC7A1\uC558\uB2E4.\n\uB77C\uC774\uBC8C2: \uB2E4\uC2DC.
      \uB098\uB3C4 \uAC19\uC774 \uD55C\uB2E4.\n\uC774\uBC88\uC5D0\uB294 \uB450 \uC0AC\uB78C\uC774
      \uB098\uB780\uD788 \uCC98\uC74C\uBD80\uD130 \uC2DC\uC791\uD588\uB2E4."
    action: "\uB0A8\uC544 \uC788\uB294 \uBE48\uC790\uB9AC"
    backdrop: {r: 0.22, g: 0.23, b: 0.25, a: 1}
    minimumHold: 0.8
  - title: "\uBB34\uC2EC\uCF54 \uB3CC\uC544\uBCF8 \uACF3"
    body: "\uC9D1\uC73C\uB85C \uB3CC\uC544\uC624\uB294 \uAE38\uC5D0, \uC8FC\uC778\uACF5\uC740
      \uBB34\uC2EC\uCF54 \uC606\uC744 \uB3CC\uC544\uBCF4\uC558\uB2E4.\n\uC5B8\uC81C\uB098
      \uD55C\uB9C8\uB514 \uBCF4\uD0DC\uB358 \uBE5B\uC740 \uC5C6\uC5C8\uB2E4.\n\n\uC8FC\uC778\uACF5\uC740
      \uD55C\uB3D9\uC548 \uADF8 \uC790\uB9AC\uB97C \uBCF4\uB2E4\uAC00 \uCC9C\uCC9C\uD788
      \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4.\n\uC8FC\uC778\uACF5: \u2026\uC78A\uC9C0
      \uC54A\uC558\uC5B4.\n\uC800\uB141 \uBC14\uB78C\uC774 \uC9C0\uB098\uAC14\uB2E4."
    action: "\uC8FC\uC778\uACF5\uC758 \uC624\uB298"
    backdrop: {r: 0.16, g: 0.2, b: 0.28, a: 1}
    minimumHold: 0.8
  - title: "\uB204\uAC00 \uBCF4\uC9C0 \uC54A\uC544\uB3C4"
    body: "\uC5B4\uB290 \uB0A0, \uC77C\uC744 \uB9C8\uCE5C \uC8FC\uC778\uACF5\uC740
      \uC870\uC6A9\uD55C \uCC45\uC0C1 \uC55E\uC5D0 \uC549\uC558\uB2E4.\n\uBCBD\uC5D0\uB294
      \uC784\uBA85\uC7A5\uC774 \uAC78\uB824 \uC788\uC5C8\uACE0, \uBB38\uBC16\uC5D0\uC11C\uB294
      \uAC00\uC871\uB4E4\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4.\n\n\uC885\uC774\uC5D0
      \uC801\uD78C \uC2DD\uC744 \uC9C0\uC6E0\uB2E4\uAC00, \uB2E4\uB978 \uBC29\uBC95\uC73C\uB85C
      \uB2E4\uC2DC \uC774\uC5B4 \uBCF4\uC558\uB2E4.\n\uB9C8\uCE68\uB0B4 \uD55C \uC904\uC774
      \uAE54\uB054\uD558\uAC8C \uB9DE\uC544\uB5A8\uC5B4\uC84C\uB2E4.\n\uC8FC\uC778\uACF5\uC740
      \uD63C\uC790 \uC791\uAC8C \uC6C3\uC5C8\uB2E4. \uC624\uB298\uB3C4, \uADF8\uAC8C
      \uC88B\uC558\uB2E4."
    action: "\uC774\uC57C\uAE30\uB97C \uB9C8\uCE5C\uB2E4"
    backdrop: {r: 0.2, g: 0.23, b: 0.22, a: 1}
    minimumHold: 0.8
  - title: "\uB05D"
    body: "\uAC00\uC7A5 \uCC2C\uB780\uD588\uB358 \uC21C\uAC04\uC740, \uC544\uBB34\uB3C4
      \uBCF4\uC9C0 \uC54A\uB294 \uACF3\uC5D0\uB3C4 \uC788\uC5C8\uB2E4.\n\n\uC8FC\uC778\uACF5\uC758
      \uC774\uC57C\uAE30\uB294 \uC5EC\uAE30\uC11C \uB9C9\uC744 \uB0B4\uB9BD\uB2C8\uB2E4."
    action: "\uC5D4\uB529 \uB2E4\uC2DC\uBCF4\uAE30"
    backdrop: {r: 0.075, g: 0.12, b: 0.15, a: 1}
    minimumHold: 0.8
  protagonist: {r: 0.4, g: 0.67, b: 0.7, a: 1}
  family: {r: 0.78, g: 0.61, b: 0.43, a: 1}
  gold: {r: 0.88, g: 0.75, b: 0.44, a: 1}
  fadeDuration: 0.8
  motionDuration: 1.8
