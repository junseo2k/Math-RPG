  m_Script: {fileID: 11500000, guid: 05f5f1b3a86e54b4d8dc24c1f076d4fe, type: 3}
  m_Name: HumanVillageThird
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.HumanVillageDefinition
  nextVillage: {fileID: 0}
  villageName: "\uB3CC\uBE5B \uC7A5\uD130"
  residentName: "\uCC3D\uACE0\uC9C0\uAE30"
  bossName: "\uC794\uD574\uC758 \uBB38\uC9C0\uAE30"
  arrival: "\uC7A5\uD130\uC758 \uC88C\uD310\uC740 \uBE44\uC5B4 \uC788\uACE0, \uC0AC\uB78C\uB4E4\uC740
    \uCC3D\uACE0 \uC55E\uC5D0 \uC904\uC744 \uC11C \uC788\uC5C8\uB2E4.\n\n\uCC3D\uACE0\uC9C0\uAE30:
    \uACE0\uAC1C\uB97C \uC5F4\uC5B4\uC900 \uC0AC\uB78C\uC774\uAD70. \uC218\uB808\uB294
    \uC654\uB294\uB370 \uCC3D\uACE0 \uAE38\uC774 \uBB34\uB108\uC84C\uC5B4.\n\uC8FC\uC778\uACF5:
    \uC5B4\uB514\uB85C \uAC00\uBA74 \uB418\uB098\uC694?\n\n\uC815\uB839: \uC544\uC9C1
    \uC9D0\uB3C4 \uB0B4\uB824\uB193\uC9C0 \uC54A\uC558\uC796\uC544. \uBA3C\uC800
    \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uBCF4\uC790."
  request: "\uCC3D\uACE0\uC9C0\uAE30: \uC624\uB978\uCABD \uCC3D\uACE0 \uAE38\uC758
    \uC794\uD574\uC758 \uBB38\uC9C0\uAE30\uB97C \uCAD3\uC544\uC918. \uC2DD\uB7C9\uC744
    \uAEBC\uB0B4\uC57C \uD574.\n\n\uC8FC\uC778\uACF5: \uC54C\uACA0\uC2B5\uB2C8\uB2E4.\n\uCC3D\uACE0\uC9C0\uAE30:
    \uC608\uC5B8\uC758 \uC7AC\uB09C\uC774 \uC628\uB2E4\uB294\uB370, \uC624\uB298
    \uBA39\uC744 \uAC83\uBD80\uD130 \uAC71\uC815\uD574\uC57C \uD558\uB2C8\u2026\n\n\uC815\uB839:
    \uC2DD\uC758 \uC870\uAC74\uBD80\uD130 \uBCF4\uC790. \uD55C \uBC88\uC5D0 \uC804\uBD80
    \uD480 \uD544\uC694\uB294 \uC5C6\uC5B4."
  aftermath: "\uCC3D\uACE0\uC9C0\uAE30: \uBB38\uC774 \uC5F4\uB838\uC5B4. \uC774\uC81C
    \uC2DD\uB7C9\uC744 \uB098\uB204\uACE0, \uC9C0\uBD95\uB3C4 \uACE0\uCCD0\uC57C\uACA0\uAD70.\n\n\uC8FC\uC778\uACF5:
    \uB2E4\uC74C\uC740 \uC9C0\uBD95\uC778\uAC00\uC694.\n\uCC3D\uACE0\uC9C0\uAE30:
    \uC7A0\uAE50, \uC548\uC0C9\uC774 \uC548 \uC88B\uC544. \uBB3C\uBD80\uD130 \uB9C8\uC154.\n\n\uC815\uB839:
    \uC800 \uC0AC\uB78C\uB4E4\uC774 \uC2DD\uB7C9\uC744 \uBC1B\uACE0 \uC788\uC5B4.
    \uC9C0\uAE08 \uD55C \uC77C\uBD80\uD130 \uBCF4\uACE0 \uAC00\uC790."
  ambient: "\uC815\uB839: \uC88C\uD310\uB9C8\uB2E4 \uBD88\uC774 \uAEBC\uC838 \uC788\uB124.
    \uC0AC\uB78C\uB4E4 \uBAA9\uC18C\uB9AC\uB3C4 \uC791\uC544\uC84C\uC5B4."
  clearedAmbient: "\uC815\uB839: \uCC3D\uACE0 \uC55E\uC758 \uC904\uC774 \uC6C0\uC9C1\uC774\uAE30
    \uC2DC\uC791\uD588\uC5B4. \uC544\uC9C1 \uAC71\uC815\uC740 \uB9CE\uC544\uB3C4,
    \uC624\uB298 \uBA39\uC744 \uAC83\uC740 \uC0DD\uACBC\uB124."
  rewind: "\uC815\uB839: \uD750\uB984\uC774 \uB04A\uAE30\uAE30 \uC804\uC73C\uB85C
    \uB3CC\uC544\uAC00\uC790.\n\uB3CC\uBE5B \uC7A5\uD130\uC5D0\uC11C \uB2E4\uC2DC
    \uC900\uBE44\uD558\uBA74 \uB3FC."
