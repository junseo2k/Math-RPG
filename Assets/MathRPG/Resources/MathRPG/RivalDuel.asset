  displayName: "\uBA3C\uC800 \uAE38\uC744 \uB5A0\uB09C \uAC00\uC871"
  introduction: "\uB77C\uC774\uBC8C: \uC774\uC81C\uC57C \uC5EC\uAE30\uAE4C\uC9C0
    \uC654\uB124. \uB09C \uBC8C\uC368 \uB2E4\uC74C \uAE38\uC744 \uBCF4\uACE0 \uC788\uC5B4.\n\n\uC8FC\uC778\uACF5:
    \u2026\uBE44\uCF1C\uC904 \uC0DD\uAC01\uC740 \uC5C6\uC5B4 \uBCF4\uC774\uB294\uB370.\n\n\uB77C\uC774\uBC8C:
    \uAC19\uC740 \uC9D1\uC5D0\uC11C \uBC30\uC6E0\uC5B4\uB3C4, \uAC80\uAE4C\uC9C0
    \uAC19\uC9C0\uB294 \uC54A\uACA0\uC9C0. \uBCF4\uC5EC\uC918."
  victory: "\uB77C\uC774\uBC8C: \u2026\uB0B4\uAC00 \uBA3C\uC800 \uBC30\uC6B4 \uAC83\uB9CC
    \uBBFF\uACE0 \uC788\uC5C8\uB098.\n\uB124 \uAC80, \uC804\uBCF4\uB2E4 \uD6E8\uC52C
    \uB2E8\uB2E8\uD574\uC84C\uB124.\n\n\uC8FC\uC778\uACF5: \uC774\uBC88\uC5D0\uB294
    \uB0B4\uAC00 \uBA3C\uC800 \uAC08\uAC8C.\n\uC815\uB839: \uC88B\uC544. \uB2E4\uC74C\uC740
    \uC815\uB839\uC758 \uC232\uC774\uC57C."
  patternChangeLine: "\uB77C\uC774\uBC8C: \u2026\uC81C\uBC95\uC774\uB124. \uADF8\uB7FC,
    \uC774 \uD750\uB984\uB3C4 \uB530\uB77C\uC640 \uBD10."
