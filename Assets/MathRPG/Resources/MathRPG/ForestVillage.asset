  m_Script: {fileID: 11500000, guid: 97771a29cdaa4490b1baa0560e9d59ab, type: 3}
  m_Name: ForestVillage
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.ForestVillageDefinition
  villageName: "\uC138\uC78E\uC758 \uC815\uB839 \uB9C8\uC744"
  guideName: "\uC138\uC78E \uC815\uB839"
  bossName: "\uB4A4\uD2C0\uB9B0 \uBFCC\uB9AC \uC815\uB839"
  relicName: "\uC0BC\uAC01\uC758 \uC720\uBB3C"
  arrival: "\uC138\uC78E \uC815\uB839: \uC778\uAC04\uC774 \uC5EC\uAE34 \uBB34\uC2A8
    \uC77C\uC774\uC9C0? \uC232\uC758 \uC720\uBB3C\uC774 \uC0AC\uB77C\uC9C4 \uB4A4\uB85C
    \uBFCC\uB9AC\uAC00 \uB4A4\uD2C0\uB9AC\uACE0 \uC788\uC5B4.\n\n\uB3D9\uD589 \uC815\uB839:
    \uC774 \uC544\uC774\uB294 \uB0B4 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC744 \uC218
    \uC788\uC5B4. \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uC918.\n\n\uC138\uC78E \uC815\uB839:
    \u2026\uB9D0\uB9CC\uC73C\uB85C \uBBFF\uC744 \uC218\uB294 \uC5C6\uC5B4."
  request: "\uC138\uC78E \uC815\uB839: \uC624\uB978\uCABD \uBFCC\uB9AC \uBB38 \uB108\uBA38\uC5D0
    \uC6B0\uB9AC\uB97C \uC9C0\uD0A4\uB358 \uC815\uB839\uC774 \uC788\uC5B4. \uC9C0\uAE08\uC740
    \uC81C \uBE5B\uB9C8\uC800 \uC0BC\uD0A4\uACE0 \uC788\uC9C0.\n\n\uC138 \uAF2D\uC9D3\uC810\uC758
    \uD750\uB984\uC744 \uC774\uC5B4\uC8FC\uBA74 \uB418\uB3CC\uB9B4 \uC218 \uC788\uC744
    \uAC70\uC57C. \uC798\uBABB \uC787\uB354\uB77C\uB3C4 \uD3EC\uAE30\uD558\uC9C0
    \uB9C8. \uB124 \uC815\uB839\uC758 \uB3C4\uC6C0\uC744 \uBC1B\uC544\uBD10.\n\n\uC8FC\uC778\uACF5:
    \uB0B4\uAC00 \uAC00\uBCFC\uAC8C."
  reward: "\uC138\uC78E \uC815\uB839: \uBFCC\uB9AC\uAC00 \uD480\uB838\uC5B4\u2026
    \uC0BC\uAC01\uC758 \uC720\uBB3C\uB3C4 \uB3CC\uC544\uC654\uAD6C\uB098.\n\uC778\uAC04\uC740
    \uC232\uC744 \uD574\uCE60 \uAC70\uB77C\uACE0\uB9CC \uC0DD\uAC01\uD588\uB294\uB370.
    \uACE0\uB9C8\uC6CC.\n\n\uB3D9\uD589 \uC815\uB839: \uCCAB \uC870\uAC01\uC774\uC57C.
    \uB098\uBA38\uC9C0 \uB450 \uB9C8\uC744\uC5D0\uB3C4 \uD754\uC801\uC774 \uB0A8\uC544
    \uC788\uC744 \uAC70\uC57C."
  ambient: "\uC815\uB839: \uC2DC\uC120\uC774 \uCC28\uAC11\uB124. \uADF8\uB798\uB3C4
    \uBA3C\uC800 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uBCF4\uC790."
  rewind: "\uC815\uB839: \uAD1C\uCC2E\uC544. \uC138 \uAF2D\uC9D3\uC810\uC744 \uD55C
    \uBC88\uC5D0 \uC774\uC744 \uD544\uC694\uB294 \uC5C6\uC5B4.\n\uB9C8\uC744\uB85C
    \uB3CC\uC544\uAC00\uC11C, \uD558\uB098\uC529 \uB2E4\uC2DC \uC77D\uC5B4\uBCF4\uC790."
