  nextVillage: {fileID: 11400000, guid: 6b5b187184da6e14eba27180fddfd225, type: 2}
  villageName: "\uC7BF\uBE5B \uB098\uB8E8"
  residentName: "\uB098\uB8E8\uC9C0\uAE30"
  bossName: "\uD0C1\uB958\uC758 \uD3EC\uC2DD\uC790"
  arrival: "\uC232\uC758 \uC9D9\uC740 \uD754\uC801\uC740 \uAC15\uC744 \uB530\uB77C
    \uC778\uAC04\uB4E4\uC758 \uB098\uB8E8\uB85C \uC774\uC5B4\uC84C\uB2E4.\n\n\uB098\uB8E8\uC9C0\uAE30:
    \uAE38\uC744 \uCC3E\uB294 \uAC70\uB77C\uBA74 \uAE30\uB2E4\uB824. \uC5B4\uC82F\uBC24\uC5D0\uB3C4
    \uBC30\uAC00 \uBD80\uC11C\uC84C\uC5B4.\n\uC8FC\uC778\uACF5: \uBB34\uC2A8 \uC77C\uC774
    \uC788\uC5C8\uB098\uC694?\n\n\uB098\uB8E8\uC9C0\uAE30: \uC800 \uD0C1\uB958 \uC18D
    \uB188 \uB54C\uBB38\uC774\uC9C0. \uC9D0\uC744 \uC62E\uAE38 \uC0AC\uB78C\uB3C4
    \uC774\uC81C \uC5BC\uB9C8 \uC548 \uB0A8\uC558\uC5B4."
  request: "\uB098\uB8E8\uC9C0\uAE30: \uC624\uB978\uCABD \uBB3C\uAE38\uC744 \uB9C9\uC740
    \uD3EC\uC2DD\uC790\uB97C \uCAD3\uC544\uC918. \uBC30\uB97C \uB744\uC6B0\uC9C0
    \uBABB\uD558\uBA74 \uB0A8\uC740 \uC2DD\uB7C9\uB3C4 \uAC74\uB108\uC624\uC9C0 \uBABB\uD574.\n\n\uC8FC\uC778\uACF5:
    \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uB9C8\uC744\uB3C4 \uAD1C\uCC2E\uC544\uC9C0\uACA0\uC8E0?\n\uB098\uB8E8\uC9C0\uAE30:
    \u2026\uC624\uB298\uC740 \uBC84\uD2F0\uACA0\uC9C0.\n\n\uC815\uB839: \uC6B0\uC120
    \uB208\uC55E\uC758 \uAE38\uBD80\uD130 \uC5F4\uC5B4\uBCF4\uC790."
  aftermath: "\uB098\uB8E8\uC9C0\uAE30: \uBB3C\uAE38\uC774 \uC5F4\uB838\uAD70. \uD558\uC9C0\uB9CC
    \uC717\uB9C8\uC744\uC5D0\uB3C4 \uBB34\uC5B8\uAC00 \uB098\uD0C0\uB0AC\uB300. \uB610
    \uC9D0\uC744 \uC62E\uACA8\uC57C\uACA0\uC5B4.\n\n\uC8FC\uC778\uACF5: \u2026\uACA8\uC6B0
    \uD558\uB098 \uB05D\uB0C8\uB294\uB370.\n\n\uC815\uB839: \uB124\uAC00 \uD55C \uC77C\uC774
    \uC0AC\uB77C\uC9C4 \uAC74 \uC544\uB2C8\uC57C. \uC624\uB298 \uAC74\uB108\uAC08
    \uC0AC\uB78C\uB4E4\uC740 \uB124 \uB355\uBD84\uC5D0 \uAC08 \uC218 \uC788\uC5B4."
  ambient: "\uC815\uB839: \uB2E4\uB4E4 \uC11C\uB450\uB974\uACE0 \uC788\uB124. \uB108\uB3C4
    \uACC4\uC18D \uC55E\uB9CC \uBCF4\uACE0 \uC788\uC5B4. \uC7A0\uAE50 \uC228\uC744
    \uACE8\uB77C\uB3C4 \uAD1C\uCC2E\uC544."
  clearedAmbient: "\uC815\uB839: \uC544\uAE4C\uBCF4\uB2E4 \uC5B4\uAE68\uAC00 \uB0B4\uB824\uAC14\uC5B4.
    \uC774\uACBC\uB294\uB370\uB3C4\u2026 \uB9CE\uC774 \uC9C0\uCE5C \uAC70\uC57C?"
  rewind: "\uC815\uB839: \uC544\uC9C1 \uB0B4\uAC00 \uBD99\uC7A1\uACE0 \uC788\uC5B4.\n\uB098\uB8E8\uB85C
    \uB3CC\uC544\uAC00\uC790. \uC11C\uB450\uB974\uC9C0 \uC54A\uC544\uB3C4 \uB3FC."
