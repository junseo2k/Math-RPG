  m_Script: {fileID: 11500000, guid: 9196ebe761498a84b88c558a5a2cf251, type: 3}
  m_Name: RivalSecond
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.RivalSecondDefinition
  rivalName: "\uB77C\uC774\uBC8C2"
  introduction: "\uB4A4\uB2A6\uAC8C \uB3C4\uCC29\uD55C \uCE5C\uAD6C\uAC00 \uC8FC\uC778\uACF5\uC758
    \uC190\uC5D0\uC11C \uC778\uC7A5\uC744 \uAC00\uC838\uAC14\uB2E4.\n\uB77C\uC774\uBC8C2:
    \uACF5\uC801\uC740 \uB354 \uAC15\uD55C \uC0AC\uB78C\uC774 \uAC16\uB294 \uAC70\uC57C.
    \uC655\uAD6D\uC758 \uADDC\uCE59\uC774\uC796\uC544.\n\n\uC8FC\uBBFC\uB4E4\uC740
    \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD588\uB2E4.\n\uC8FC\uC778\uACF5:
    \u2026\uB3CC\uB824\uB2EC\uB77C.\n\uB77C\uC774\uBC8C2: \uADF8\uB7FC \uC99D\uBA85\uD574.
    \uC5EC\uAE30\uC11C."
  breakdown: "\uB2F5\uC740 \uC54C\uACE0 \uC788\uB2E4. \uADF8\uB7F0\uB370 \uC190\uC774
    \uB530\uB77C\uC624\uC9C0 \uC54A\uB294\uB2E4.\n\n\uC544\uBB34\uB3C4 \uAC74\uB4DC\uB9AC\uC9C0
    \uC54A\uC558\uB294\uB370 \uC2DD\uC774 \uD754\uB4E4\uB824 \uBCF4\uC600\uB2E4.\n\uC815\uB839:
    \uB0B4 \uBAA9\uC18C\uB9AC \uB4E4\uB824? \uC228\uC744\u2026\n\n\uC8FC\uC778\uACF5\uC740
    \uB8EC \uC7A5\uAC11\uC5D0 \uD798\uC744 \uC8FC\uC5C8\uB2E4.\n\uBD80\uBAA8\uB2D8\uC5D0\uAC8C
    \uB3CC\uC544\uAC00\uC57C \uD55C\uB2E4. \uC778\uC7A5\uC774 \uC788\uC5B4\uC57C
    \uD55C\uB2E4."
  defeat: "\uC7A5\uAC11\uC5D0\uB294 \uBE5B\uC774 \uB9FA\uD788\uC9C0 \uC54A\uC558\uB2E4.
    \uAC80\uC774 \uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC84C\uB2E4.\n\n\uB77C\uC774\uBC8C2:
    \uADF8\uB7FC \uADF8 \uC790\uB9AC\uB294 \uB0B4\uAC00 \uBC1B\uACA0\uAD70.\n\n\uADF8\uB294
    \uC778\uC7A5\uC744 \uCC59\uACA8 \uB5A0\uB0AC\uB2E4.\n\uC8FC\uC778\uACF5\uC740
    \uB72F\uC9C0 \uBABB\uD55C \uB2F5\uC7A5\uC774 \uB4E0 \uD488\uC744 \uC6C0\uCF1C\uC950\uC5C8\uB2E4."
  departure: "\uC8FC\uC778\uACF5\uC740 \uC0AC\uB78C\uB4E4 \uC0AC\uC774\uB97C \uBC00\uCE58\uACE0
    \uB6F0\uCCD0\uB098\uAC14\uB2E4.\n\uC815\uB839: \uAE30\uB2E4\uB824\u2026!\n\n\uADF8\uB0A0
    \uC774\uD6C4, \uB9C8\uC744\uC5D0\uC11C \uC8FC\uC778\uACF5\uC744 \uBCF8 \uC0AC\uB78C\uC740
    \uC5C6\uC5C8\uB2E4.\n\n\uB2F5\uC7A5\uC740 \uC5EC\uC804\uD788 \uB72F\uC9C0 \uC54A\uC740
    \uCC44\uC600\uB2E4.\n\uCC55\uD1303 \u2014 \uB05D"
