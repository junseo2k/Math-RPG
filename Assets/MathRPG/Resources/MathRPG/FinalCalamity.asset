  m_Script: {fileID: 11500000, guid: 8f2fa3ce793292641ba67b114a371063, type: 3}
  m_Name: FinalCalamity
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.FinalCalamityDefinition
  bossName: "\uC7AC\uC559 \u2014 \uC5B4\uB460\uC758 \uAE30\uC0AC"
  introduction: "\uAE38 \uB05D\uC5D0\uB294 \uAC80\uC740 \uAC11\uC637\uC744 \uB450\uB978
    \uAE30\uC0AC\uAC00 \uC11C \uC788\uC5C8\uB2E4.\n\uADF8 \uC8FC\uC704\uC5D0\uC11C
    \uBA3C\uC9C0\uC640 \uBE57\uBC29\uC6B8\uC774 \uAC70\uAFB8\uB85C \uD758\uB800\uB2E4.\n\n\uC815\uB839:
    \uC6D0\uB798\uBD80\uD130 \uC815\uB839\uC774\uC5C8\uB358 \uC874\uC7AC\uC57C. \uB9C8\uB825\uC5D0
    \uCDE8\uD574 \uC800\uB807\uAC8C \uB41C \uAC70\uC9C0.\n\n\uC8FC\uC778\uACF5\uC740
    \uAC80\uC744 \uC950\uC5C8\uB2E4. \uAE30\uC0AC\uAC00 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
  farewell: "\uC815\uB839: \u2026\uC800\uAC78 \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uB098\uB3C4
    \uC0AC\uB77C\uC9C0\uACA0\uC9C0.\n\uB098\uB97C \uC5EC\uAE30\uB85C \uBCF4\uB0B8
    \uD798\uB3C4 \uC800 \uC7AC\uC559\uC5D0 \uB0A8\uC544 \uC788\uB358 \uAC70\uB2C8\uAE4C.\n\n\uC8FC\uC778\uACF5:
    \uC54C\uACE0 \uC788\uC5C8\uC5B4?\n\uC815\uB839: \uC751. \uADF8\uB798\uB3C4 \uB108\uB97C
    \uB9CC\uB09C \uAC74 \uD6C4\uD68C\uD558\uC9C0 \uC54A\uC544.\n\uB124\uAC00 \uC88B\uC544\uD588\uB358
    \uADF8 \uAC10\uAC01, \uC78A\uC9C0 \uB9C8.\n\n\uC815\uB839\uC740 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
    \uC774 \uC21C\uAC04\uC744 \uAE30\uC5B5\uC5D0 \uB0A8\uACBC\uB2E4."
  isolation: "\uAE30\uC0AC\uAC00 \uAC80\uC744 \uB0B4\uB9AC\uAE0B\uC790 \uB450 \uC0AC\uB78C
    \uC0AC\uC774\uC758 \uACF5\uAC04\uC774 \uAC08\uB77C\uC84C\uB2E4.\n\uC815\uB839\uC758
    \uBAA9\uC18C\uB9AC\uAC00 \uB04A\uACBC\uB2E4. \uC190\uC744 \uBED7\uC5B4\uB3C4
    \uB2FF\uC9C0 \uC54A\uC558\uB2E4.\n\n\uC8FC\uC778\uACF5: \u2026\uC774\uC81C \uB0B4
    \uC190\uC73C\uB85C.\n\nQ \uB8EC \uB300\uACB0 \xB7 1~4 \uB2F5 \uC120\uD0DD \xB7
    R \uB2E4\uB978 \uD480\uC774\n\uC815\uB2F5\uC774\uC5B4\uB3C4 \uC7A5\uD310\uC740
    \uC9C1\uC811 \uD53C\uD574\uC57C \uD55C\uB2E4.\n\uD328\uBC30\uD558\uBA74 \uC815\uB839\uC774
    \uB0A8\uAE34 \uACA9\uB9AC \uC9C1\uC804\uC758 \uAE30\uB85D\uC5D0\uC11C \uB2E4\uC2DC
    \uC2DC\uC791\uD55C\uB2E4."
  phaseTwo: "\uAE30\uC0AC\uAC00 \uAC80\uC744 \uB3CC\uB838\uB2E4. \uC8FC\uC778\uACF5\uC758
    \uC190\uB05D\uC774 \uD22C\uBA85\uD558\uAC8C \uD754\uB4E4\uB838\uB2E4.\n\uC7AC\uC559:
    \uB108\uB3C4 \uACB0\uAD6D \uAC19\uC740 \uBAA8\uC2B5\uC774 \uB420 \uAC83\uC774\uB2E4.\n\n\uB450
    \uBC88\uC9F8 \uD398\uC774\uC988 \u2014 \uC2DC\uAC04\uC774 \uB354 \uC9E7\uC544\uC9C0\uACE0
    \uC815\uB839\uD654\uAC00 \uC2DC\uC791\uB41C\uB2E4.\n\uC815\uB839\uD654 \uC608\uACE0
    \uD6C4 \uC7A0\uC2DC \uACF5\uACA9\xB7\uC2A4\uD0AC\xB7\uB8EC\uC744 \uC4F8 \uC218
    \uC5C6\uB2E4.\nA/D \uC774\uB3D9, SPACE \uC810\uD504, S \uC219\uC774\uAE30\uB294
    \uACC4\uC18D \uC0AC\uC6A9\uD560 \uC218 \uC788\uB2E4.\n\n\uC8FC\uC778\uACF5\uC740
    \uD55C \uBC1C \uBB3C\uB7EC\uC11C\uBA70 \uAC80\uC758 \uADA4\uC801\uC744 \uC0B4\uD3C8\uB2E4."
  phaseThree: "\uB8EC\uC774 \uB9FA\uD788\uAE30\uB3C4 \uC804\uC5D0 \uC2DC\uAC04\uC774
    \uC798\uB824 \uB098\uAC14\uB2E4.\n\uC2DD\uC73C\uB85C \uC7A5\uD310\uC744 \uC904\uC774\uB358
    \uD750\uB984\uC740 \uB354 \uC774\uC0C1 \uC774\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4.\n\n\uC8FC\uC778\uACF5:
    \uB2F5\uC744 \uC801\uB294 \uC190\uB9CC \uB0B4 \uD798\uC778 \uAC74 \uC544\uB2C8\uC57C.\n\n\uB9C8\uC9C0\uB9C9
    \uD398\uC774\uC988 \u2014 Q \uB8EC \uB300\uACB0\uC744 \uC0AC\uC6A9\uD560 \uC218
    \uC5C6\uB2E4.\n\uB113\uC740 \uC989\uC0AC \uC7A5\uD310\uC744 \uD53C\uD55C \uB4A4
    J \uAC80\uACA9\uACFC K \uC794\uAD11\uC73C\uB85C \uBC18\uACA9\uD558\uC790.\n\uC815\uB839\uD654
    \uC911\uC5D0\uB294 \uD68C\uD53C\uC5D0 \uC9D1\uC911\uD558\uC790."
  victory: "\uAC80\uC774 \uAC80\uC740 \uAC11\uC637\uC744 \uAC08\uB790\uB2E4. \uBA48\uCDB0
    \uC788\uB358 \uBE57\uBC29\uC6B8\uC774 \uB545\uC5D0 \uB2FF\uC558\uB2E4.\n\uC7AC\uC559\uC758
    \uD615\uCCB4\uAC00 \uD769\uC5B4\uC9C0\uBA70 \uB4A4\uD2C0\uB9B0 \uB9C8\uB825\uB3C4
    \uC7A6\uC544\uB4E4\uC5C8\uB2E4.\n\n\uC8FC\uC778\uACF5\uC740 \uACC1\uC744 \uB3CC\uC544\uBCF4\uC558\uB2E4.
    \uC775\uC219\uD55C \uBE5B\uC740 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4.\n\n\uC8FC\uC778\uACF5:
    \u2026\uAE30\uC5B5\uD560\uAC8C.\n\n\uC190\uC5D0 \uB0A8\uC740 \uAC10\uAC01\uB9CC\uC740
    \uC790\uC2E0\uC758 \uAC83\uC774\uC5C8\uB2E4."
  problems:
  - title: "\uB450 \uC81C\uACF1 \uC0AC\uC774"
    directSteps:
    - prompt: "101\xB2 \u2212 99\xB2\uC744 \uACC4\uC0B0\uD55C\uB2E4. \uBA3C\uC800
        101\xB2\uC740?"
      choices:
      - 10201
      - 10001
      - 10200
      - 10101
      correctIndex: 0
    - prompt: "101\xB2 = 10201. \uC774\uBC88\uC5D0\uB294 99\xB2\uC740?"
      choices:
      - 9901
      - 9801
      - 9604
      - 9999
      correctIndex: 1
    - prompt: "10201 \u2212 9801\uC758 \uAC12\uC740?"
      choices:
      - 200
      - 398
      - 400
      - 402
      correctIndex: 2
    shortcut:
      prompt: "101\xB2 \u2212 99\xB2\uC758 \uAC12\uC740? \uB450 \uC81C\uACF1\uC758
        \uCC28\uB85C \uC0DD\uAC01\uD574\uBCF4\uC790."
      choices:
      - 200
      - 400
      - 800
      - 4
      correctIndex: 1
    insight: "101\xB2 \u2212 99\xB2 = (101\u221299)(101+99). \uAC01\uAC01 \uC81C\uACF1\uD558\uAE30
      \uC804\uC5D0 \uB450 \uC218\uC758 \uCC28\uC640 \uD569\uC744 \uBCF4\uC790."
  - title: "\uACF1\uC148\uC744 \uB05D\uAE4C\uC9C0 \uD558\uC9C0 \uC54A\uACE0"
    directSteps:
    - prompt: "2\u2079 \xF7 2\u2076\uC744 \uACC4\uC0B0\uD55C\uB2E4. \uBA3C\uC800
        2\u2079\uC740?"
      choices:
      - 256
      - 1024
      - 128
      - 512
      correctIndex: 3
    - prompt: "\uBD84\uC790\uB294 512. \uBD84\uBAA8 2\u2076\uC740?"
      choices:
      - 32
      - 64
      - 128
      - 12
      correctIndex: 1
    - prompt: "512 \xF7 64\uC758 \uAC12\uC740?"
      choices:
      - 8
      - 16
      - 4
      - 32
      correctIndex: 0
    shortcut:
      prompt: "2\u2079 \xF7 2\u2076\uC758 \uAC12\uC740?"
      choices:
      - 2
      - 4
      - 8
      - 64
      correctIndex: 2
    insight: "\uAC19\uC740 \uBC11\uC758 \uAC70\uB4ED\uC81C\uACF1\uC744 \uB098\uB204\uBA74
      \uC9C0\uC218\uB97C \uBE80\uB2E4. 2\u2079 \xF7 2\u2076 = 2\xB3."
  - title: "\uC2DD\uC744 \uD558\uB098\uB85C \uC811\uAE30"
    directSteps:
    - prompt: "x=103\uC5D0\uC11C x\xB2 \u2212 6x + 9\uB97C \uACC4\uC0B0\uD55C\uB2E4.
        \uBA3C\uC800 103\xB2\uC740?"
      choices:
      - 10609
      - 10600
      - 10309
      - 10909
      correctIndex: 0
    - prompt: "103\xB2 = 10609. \uBE7C\uC57C \uD560 6\xD7103\uC740?"
      choices:
      - 603
      - 636
      - 618
      - 609
      correctIndex: 2
    - prompt: "10609 \u2212 618 + 9\uC758 \uAC12\uC740?"
      choices:
      - 9991
      - 10009
      - 10100
      - 10000
      correctIndex: 3
    shortcut:
      prompt: "x=103\uC77C \uB54C x\xB2 \u2212 6x + 9\uC758 \uAC12\uC740?"
      choices:
      - 10609
      - 10000
      - 10009
      - 9991
      correctIndex: 1
    insight: "x\xB2 \u2212 6x + 9 = (x\u22123)\xB2. x=103\uC744 \uB123\uAE30 \uC804\uC5D0
      \uC644\uC804\uC81C\uACF1\uC2DD\uC73C\uB85C \uBB36\uC5B4\uBCF4\uC790."
