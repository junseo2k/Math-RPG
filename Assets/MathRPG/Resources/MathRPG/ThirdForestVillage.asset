  m_Script: {fileID: 11500000, guid: 97771a29cdaa4490b1baa0560e9d59ab, type: 3}
  m_Name: ThirdForestVillage
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.ForestVillageDefinition
  villageName: "\uB2EC\uACE0\uB9AC\uC758 \uC815\uB839 \uB9C8\uC744"
  guideName: "\uB2EC\uACE0\uB9AC \uC815\uB839"
  bossName: "\uB4A4\uD2C0\uB9B0 \uB2EC\uBB34\uB9AC \uC815\uB839"
  relicName: "\uC6D0\uC758 \uC720\uBB3C"
  arrival: "\uB2EC\uACE0\uB9AC \uC815\uB839: \uB450 \uB9C8\uC744\uC758 \uBE5B\uC774
    \uB124 \uACC1\uC5D0 \uC788\uAD6C\uB098. \uB124\uAC00 \uC628\uB2E4\uB294 \uC18C\uC2DD\uC744
    \uAE30\uB2E4\uB838\uC5B4.\n\n\uB9C8\uC9C0\uB9C9 \uC720\uBB3C\uC740 \uB2EC\uBB34\uB9AC
    \uC815\uB839\uC774 \uC9C0\uD0A4\uACE0 \uC788\uC5B4. \uD558\uC9C0\uB9CC \uC9C0\uAE08\uC740
    \uC6B0\uB9AC\uB97C \uC54C\uC544\uBCF4\uC9C0 \uBABB\uD574.\n\n\uC8FC\uC778\uACF5:
    \uC774\uBC88\uC5D0\uB3C4 \uB418\uB3CC\uB824\uBCFC\uAC8C."
  request: "\uB2EC\uACE0\uB9AC \uC815\uB839: \uC6D0\uC5D0 \uB2FF\uB294 \uC120\uACFC,
    \uC9C1\uAC01\uC0BC\uAC01\uD615\uC758 \uBE44\uB97C \uC77D\uC5B4\uC918. \uC0BC\uAC01\uD615\uACFC
    \uB2EE\uC74C\uC5D0\uC11C \uBC30\uC6B4 \uC5F0\uACB0\uC774 \uB3C4\uC6C0\uC774 \uB420
    \uAC70\uC57C.\n\n\uD3C9\uD3C9\uD55C \uC6D0\uC774 \uC785\uCCB4\uC758 \uBC11\uBA74\uC774
    \uB418\uAE30\uB3C4 \uD574. \uBAA8\uC591\uC774 \uBC14\uB00C\uC5B4\uB3C4 \uC544\uB294
    \uAC83\uBD80\uD130 \uCC3E\uC544\uBD10.\n\n\uB3D9\uD589 \uC815\uB839: \uB0B4\uAC00
    \uACC1\uC5D0\uC11C \uB3C4\uC6B8\uAC8C."
  reward: "\uB2EC\uACE0\uB9AC \uC815\uB839: \uB2EC\uBB34\uB9AC\uAC00 \uB2E4\uC2DC
    \uB9D1\uC544\uC84C\uC5B4. \uC6D0\uC758 \uC720\uBB3C\uB3C4 \uB3CC\uC544\uC654\uAD6C\uB098.\n\n\uB3D9\uD589
    \uC815\uB839: \uC0BC\uAC01\uD615, \uD3C9\uD589\uC0AC\uBCC0\uD615, \uC6D0\u2026
    \uC138 \uC870\uAC01\uC774 \uBAA8\uB450 \uBAA8\uC600\uC5B4.\n\n\uB2EC\uACE0\uB9AC
    \uC815\uB839: \uC774 \uBE5B\uC774\uB77C\uBA74 \uC232\uC758 \uC218\uD638 \uC815\uB839\uC744
    \uAE68\uC6B8 \uC218 \uC788\uC744 \uAC70\uC57C."
  ambient: "\uC815\uB839: \uC5EC\uAE30\uC11C\uB294 \uB098\uBB47\uC78E \uC0AC\uC774\uB85C
    \uB465\uADFC \uBE5B\uC774 \uB0B4\uB824\uC640. \uC774\uC81C \uB2E4\uB4E4 \uC6B0\uB9AC\uB97C
    \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB124."
  rewind: "\uC815\uB839: \uAD1C\uCC2E\uC544. \uC6D0\uB3C4 \uC0BC\uAC01\uD615\uB3C4,
    \uC774\uBBF8 \uC77D\uC5B4\uB0B8 \uC5F0\uACB0\uC774 \uC788\uC5B4.\n\uB2EC\uACE0\uB9AC
    \uB9C8\uC744\uC5D0\uC11C \uB2E4\uC2DC \uC900\uBE44\uD558\uC790."
  questions:
