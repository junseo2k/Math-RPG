  m_Script: {fileID: 11500000, guid: 171e3469a1494adb9d4a9929f92a6e2b, type: 3}
  m_Name: ForestClimax
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.ForestClimaxDefinition
  bossName: "\uD0C0\uB77D \uC815\uB839 \uC9D1\uD569\uCCB4"
  awakening: "\uC0BC\uAC01\uD615, \uD3C9\uD589\uC0AC\uBCC0\uD615, \uC6D0\uC758 \uBE5B\uC774
    \uD558\uB098\uC758 \uACE0\uB9AC\uB85C \uC774\uC5B4\uC84C\uB2E4.\n\n\uC218\uD638
    \uC815\uB839: \uC232\uC758 \uBAA9\uC18C\uB9AC\uB97C \uB418\uCC3E\uC544 \uC8FC\uC5C8\uAD6C\uB098.
    \uD769\uC5B4\uC9C4 \uBD84\uB178\uAC00 \uAE4A\uC740 \uACF3\uC5D0\uC11C \uD558\uB098\uB85C
    \uC5C9\uCF1C \uC788\uB2E4.\n\n\uB0B4 \uBE5B\uC744 \uBE4C\uB824\uC8FC\uB9C8. \uB124
    \uAC80\uACFC \uD568\uAED8 \uADF8 \uACB0\uC18D\uC744 \uD480\uC5B4\uB77C."
  introduction: "\uC815\uB839: \uB9C8\uB825\uC744 \uD0D0\uD558\uB358 \uC778\uAC04\uB4E4\uC774
    \uB0A8\uAE34 \uC0C1\uCC98\uAC00\u2026 \uC774\uB807\uAC8C \uBAA8\uC778 \uAC70\uC57C.\n\n\uC218\uD638
    \uC815\uB839: \uC798\uBABB \uC774\uC740 \uBE5B\uC740 \uC0DD\uBA85\uC744 \uBE7C\uC557\uACE0
    \uACF5\uACA9\uC744 \uC7AC\uCD09\uD55C\uB2E4. \uB2E4\uC2DC \uC77D\uC5B4\uB0B4\uBA74
    \uADF8 \uD798\uB3C4 \uC7A6\uC544\uB4E4 \uAC83\uC774\uB2E4.\n\n\uC138 \uD750\uB984\uC744
    \uC644\uC131\uD574\uB77C. \uADF8 \uD2C8\uC5D0 \uB0B4\uAC00 \uACB0\uC18D\uC744
    \uB04A\uACA0\uB2E4."
  victory: "\uD769\uC5B4\uC9C4 \uC815\uB839\uB4E4\uC758 \uBE5B\uC774 \uB098\uBB34
    \uC0AC\uC774\uB85C \uB3CC\uC544\uAC14\uB2E4.\n\n\uB2EC\uACE0\uB9AC \uC815\uB839:
    \uC232\uC744 \uC9C0\uCF1C\uC918\uC11C \uACE0\uB9C8\uC6CC. \uB124\uAC00 \uCC3E\uB294
    \uC9D9\uC740 \uC0C9 \uC2AC\uB77C\uC784\uC740 \uC232 \uAE4A\uC740 \uCABD\uC5D0\uC11C
    \uBCF4\uC558\uC5B4.\n\n\uC8FC\uC778\uACF5: \uC774\uC81C \uC5B4\uB514\uB85C \uAC00\uC57C
    \uD560\uC9C0 \uC54C\uACA0\uC5B4.\n\uC815\uB839: \uD568\uAED8 \uAC00\uC790. \uC232\uC740
    \uC6B0\uB9AC\uB97C \uAE30\uC5B5\uD560 \uAC70\uC57C."
