  m_Script: {fileID: 11500000, guid: 97771a29cdaa4490b1baa0560e9d59ab, type: 3}
  m_Name: SecondForestVillage
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.ForestVillageDefinition
  villageName: "\uBB3C\uACB0\uC758 \uC815\uB839 \uB9C8\uC744"
  guideName: "\uBB3C\uACB0 \uC815\uB839"
  bossName: "\uB4A4\uD2C0\uB9B0 \uBB3C\uAC70\uC6B8 \uC815\uB839"
  relicName: "\uD3C9\uD589\uC0AC\uBCC0\uD615\uC758 \uC720\uBB3C"
  arrival: "\uBB3C\uACB0 \uC815\uB839: \uC138\uC78E \uB9C8\uC744\uC5D0\uC11C \uC628
    \uC778\uAC04\uC774\uAD6C\uB098. \uB124\uAC00 \uBFCC\uB9AC\uB97C \uD480\uC5C8\uB2E4\uB294
    \uC774\uC57C\uAE30\uB294 \uB4E4\uC5C8\uC5B4.\n\n\uD558\uC9C0\uB9CC \uC774\uACF3\uC758
    \uBB3C\uC740 \uC544\uC9C1 \uB4A4\uD2C0\uB824 \uC788\uC5B4. \uBB3C\uAC70\uC6B8\uC744
    \uC9C0\uD0A4\uB358 \uC815\uB839\uB3C4 \uC6B0\uB9AC \uBAA9\uC18C\uB9AC\uB97C \uB4E3\uC9C0
    \uBABB\uD574.\n\n\uC8FC\uC778\uACF5: \uC5B4\uB5A4 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0
    \uB4E4\uB824\uC918."
  request: "\uBB3C\uACB0 \uC815\uB839: \uB9C8\uB825\uC744 \uAC00\uC838\uAC00\uB824\uB358
    \uC778\uAC04\uB4E4\uC774 \uBB3C\uAE38\uC758 \uC720\uBB3C\uC744 \uAC74\uB4DC\uB838\uC5B4.
    \uADF8 \uB4A4\uB85C \uBB3C\uAC70\uC6B8\uC774 \uBE5B\uC744 \uC0BC\uD0A4\uAE30
    \uC2DC\uC791\uD588\uC9C0.\n\n\uB9C8\uC8FC \uBCF4\uB294 \uBCC0, \uAC19\uC740 \uBAA8\uC591\uC758
    \uBE44\uC728, \uC9C1\uAC01\uC758 \uC5F0\uACB0\uC744 \uC77D\uC5B4\uC918. \uC55E\uC11C
    \uBC30\uC6B4 \uC0BC\uAC01\uD615\uB3C4 \uB3C4\uC6C0\uC774 \uB420 \uAC70\uC57C.\n\n\uB3D9\uD589
    \uC815\uB839: \uC11C\uB450\uB974\uC9C0 \uB9D0\uACE0 \uD558\uB098\uC529 \uC774\uC5B4\uBCF4\uC790."
  reward: "\uBB3C\uACB0 \uC815\uB839: \uBB3C \uC704\uC5D0 \uD558\uB298\uC774 \uB2E4\uC2DC
    \uBE44\uCCD0\u2026 \uD3C9\uD589\uC0AC\uBCC0\uD615\uC758 \uC720\uBB3C\uC744 \uB418\uCC3E\uC558\uAD6C\uB098.\n\n\uC8FC\uC778\uACF5:
    \uC774\uC81C \uC870\uAE08\uC740 \uBBFF\uC5B4\uC904 \uC218 \uC788\uC5B4?\n\n\uBB3C\uACB0
    \uC815\uB839: \uB124\uAC00 \uD55C \uC77C\uC740 \uC78A\uC9C0 \uC54A\uC744\uAC8C.
    \uB0A8\uC740 \uC720\uBB3C\uC740 \uB354 \uAE4A\uC740 \uC232\uC5D0 \uC788\uC5B4."
  ambient: "\uC815\uB839: \uBB3C\uC18D\uC758 \uB098\uBB34\uB3C4 \uAC19\uC740 \uBAA8\uC591\uC774\uB124.
    \uD06C\uAE30\uAC00 \uB2EC\uB77C\uB3C4 \uC774\uC5B4\uC9C0\uB294 \uAC8C \uC788\uC5B4."
  rewind: "\uC815\uB839: \uC774\uBC88\uC5D0 \uC77D\uC740 \uD750\uB984\uC740 \uC0AC\uB77C\uC9C0\uC9C0
    \uC54A\uC544.\n\uBB3C\uACB0 \uB9C8\uC744\uB85C \uB3CC\uC544\uAC00 \uB2E4\uC2DC
    \uC900\uBE44\uD558\uC790."
  questions:
