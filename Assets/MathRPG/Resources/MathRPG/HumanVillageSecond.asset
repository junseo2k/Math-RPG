  m_Script: {fileID: 11500000, guid: 05f5f1b3a86e54b4d8dc24c1f076d4fe, type: 3}
  m_Name: HumanVillageSecond
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.HumanVillageDefinition
  nextVillage: {fileID: 11400000, guid: e9bbe583f6236bb4585480cc373cfdff, type: 2}
  villageName: "\uBC14\uB78C\uACE0\uAC1C"
  residentName: "\uACE0\uAC1C\uC9C0\uAE30"
  bossName: "\uB2A5\uC120\uC758 \uD30C\uC218\uAFBC"
  arrival: "\uAC15\uC744 \uBC97\uC5B4\uB098\uC790 \uC9C0\uBD95\uC744 \uBB36\uC740
    \uBC27\uC904\uB4E4\uC774 \uBC14\uB78C\uC5D0 \uC6B8\uC5C8\uB2E4.\n\n\uACE0\uAC1C\uC9C0\uAE30:
    \uB098\uB8E8\uC5D0\uC11C \uC654\uB098? \uBB3C\uAE38\uC774 \uC5F4\uB838\uB2E4\uB354\uB2C8,
    \uC774\uBC88\uC5D4 \uACE0\uAC2F\uAE38\uC774 \uB9C9\uD614\uC5B4.\n\uC8FC\uC778\uACF5:
    \uC5EC\uAE30\uB3C4\uC694?\n\n\uC815\uB839: \uC0AC\uB78C\uB4E4\uC740 \uD558\uB298\uB9CC
    \uBCF4\uACE0 \uC788\uB124. \uBC14\uB78C\uC774 \uBD88 \uB54C\uB9C8\uB2E4 \uC9D0\uC744
    \uB04C\uC5B4\uC548\uACE0 \uC788\uC5B4."
  request: "\uACE0\uAC1C\uC9C0\uAE30: \uB2A5\uC120\uC758 \uD30C\uC218\uAFBC\uC774
    \uBCF4\uAE09 \uC218\uB808\uB97C \uB3CC\uB824\uBCF4\uB0B4\uACE0 \uC788\uC5B4.
    \uC624\uB978\uCABD \uACE0\uAC2F\uAE38\uC744 \uC5F4\uC5B4\uC918.\n\n\uC8FC\uC778\uACF5:
    \uAE38\uB9CC \uC5F4\uBA74 \uB418\uB294 \uAC70\uC8E0.\n\uACE0\uAC1C\uC9C0\uAE30:
    \uADF8\uB798. \u2026\uC548\uC0C9\uC774 \uC548 \uC88B\uC740\uB370, \uC7A0\uAE50
    \uC26C\uACE0 \uAC00\uB3C4 \uB3FC.\n\n\uC815\uB839: \uC62C\uB77C\uAC14\uB2E4 \uB0B4\uB824\uC624\uB294
    \uD750\uB984\uC5D0\uB3C4 \uAF2D\uC9D3\uC810\uC774 \uC788\uC5B4. \uD558\uB098\uC529
    \uC0B4\uD3B4\uBCF4\uC790."
  aftermath: "\uACE0\uAC1C\uC9C0\uAE30: \uC218\uB808\uAC00 \uB118\uC5B4\uC654\uC5B4.
    \uACE0\uB9D9\u2026 \uADF8\uB7F0\uB370 \uB2E4\uC74C \uB9C8\uC744\uC5D0\uC11C\uB3C4
    \uAD6C\uD638\uD488\uC744 \uBCF4\uB0B4\uB2EC\uB77C\uB294\uAD70.\n\n\uC8FC\uC778\uACF5:
    \uB610 \uB2E4\uC74C\uC778\uAC00\uC694.\n\uACE0\uAC1C\uC9C0\uAE30: \uC608\uC5B8\uC774
    \uB9DE\uB294 \uAC70\uB77C\uBA74, \uAE38 \uD558\uB098 \uC5F4\uB9B0\uB4E4 \uAD1C\uCC2E\uC544\uC9C8\uAE4C.\n\n\uC815\uB839:
    \uC9C0\uAE08\uC740 \uB124\uAC00 \uC5F0 \uAE38\uB85C \uC0AC\uB78C\uB4E4\uC774
    \uB3CC\uC544\uC624\uACE0 \uC788\uC5B4. \uADF8\uAC74 \uBD84\uBA85\uD574."
  ambient: "\uC815\uB839: \uC5EC\uAE30\uC120 \uBC14\uB78C \uC18C\uB9AC\uC5D0\uB3C4
    \uC0AC\uB78C\uB4E4\uC774 \uC6C0\uCC14\uD574. \uB108\uAE4C\uC9C0 \uC11C\uB450\uB97C
    \uD544\uC694\uB294 \uC5C6\uC5B4."
  clearedAmbient: "\uC815\uB839: \uAE38\uC740 \uC870\uC6A9\uD574\uC84C\uB294\uB370
    \uC0AC\uB78C\uB4E4 \uC5BC\uAD74\uC740 \uADF8\uB300\uB85C\uB124. \uB124\uAC00
    \uBABB\uD574\uC11C \uADF8\uB7F0 \uAC74 \uC544\uB2C8\uC57C."
  rewind: "\uC815\uB839: \uC544\uC9C1 \uB2A6\uC9C0 \uC54A\uC558\uC5B4.\n\uBC14\uB78C\uACE0\uAC1C\uB85C
    \uB3CC\uC544\uAC00\uC11C \uD750\uB984\uC744 \uB2E4\uC2DC \uBCF4\uC790."
