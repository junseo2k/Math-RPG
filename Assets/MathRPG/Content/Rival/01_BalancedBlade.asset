  title: "\uB450 \uACB9\uC758 \uADE0\uD615"
  steps:
  - phase: "\uC870\uC900"
    prompt: "2(x + 1) = 8. \uAD04\uD638 \uC548\uC758 \uD750\uB984\uC744 \uBA3C\uC800
