--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 08aec338cc27a184ca8ae1b1edfc36e0, type: 3}
  m_Name: TrainingDialogue
  m_EditorClassIdentifier: MathRPG.Runtime::MathRPG.DialogueDefinition
  introduction:
  - "\uC655\uC740 \uC815\uB839\uC758 \uC232\uC5D0\uC11C \uC790\uC2E0\uC758 \uC778\uC7A5\uC744
    \uCC3E\uC544\uC624\uB294 \uC790\uC5D0\uAC8C\n\uCD1D\uC0AC\uB839\uAD00\uC758 \uC790\uB9AC\uB97C
    \uB0B4\uB9AC\uACA0\uB2E4\uACE0 \uACF5\uD45C\uD588\uB2E4.\n\n\uC232\uC73C\uB85C
    \uD5A5\uD558\uAE30 \uC804, \uB098\uB294 \uC655\uAD6D\uC758 \uD6C8\uB828\uC18C\uC5D0
    \uB4E4\uC5B4\uC130\uB2E4."
  - "\uAD50\uAD00: \uBCF4\uAE09\uBC1B\uC740 \uB8EC \uC7A5\uAC11\uC740 \uC7A5\uC2DD\uC774
    \uC544\uB2C8\uB2E4.\n\uAC80\uACA9\uC740 \uC190\uC73C\uB85C, \uD070 \uAE30\uC220\uC740
    \uC815\uD655\uD55C \uC0DD\uAC01\uC73C\uB85C \uC6C0\uC9C1\uC778\uB2E4.\n\n\uC8FC\uC778\uACF5:
    \u2026\uB098\uB294 \uCE7C\uC774 \uBA3C\uC800\uB77C\uACE0 \uC0DD\uAC01\uD588\uB294\uB370."
  - "\uC815\uB839: \uC190\uC5D0 \uB4E0 \uBE5B\uC774 \uBCF4\uC774\uC9C0? \uD750\uB984\uC744
    \uD568\uAED8 \uC77D\uC5B4\uBCF4\uC790.\n\uB098\uB3C4 \uC5EC\uAE30\uC11C \uCC38
    \uB9CE\uC774 \uB118\uC5B4\uC84C\uC5B4.\n\n\uAD50\uAD00\uC740 \uC67C\uCABD\uC5D0
    \uC788\uB2E4. \uC624\uB978\uCABD\uC5D0\uC11C\uB294 \uC790\uC720\uB86D\uAC8C \uAC80\uC744
    \uC2DC\uD5D8\uD574\uB77C."
  ambient:
  - "\uD6C8\uB828\uC0DD: \uC544\uBB34\uB3C4 \uC548 \uBCF4\uB358 \uC0C8\uBCBD\uC5D0\n\uCC98\uC74C
    \uAC80\uC744 \uB05D\uAE4C\uC9C0 \uD718\uB458\uB800\uC9C0.\n\uB09C \uADF8\uB54C\uAC00
    \uC81C\uC77C \uC120\uBA85\uD574."
  rewind:
  - "\uC815\uB839: \uAD1C\uCC2E\uC544. \uC774\uBC88\uC5D4 \uBC1C\uBC11\uBD80\uD130
    \uBCFC\uAE4C?\n\uB0B4\uAC00 \uC870\uAE08 \uC804\uC73C\uB85C \uB3CC\uB824\uC904\uAC8C."
  - "\uC815\uB839: \uB098\uB3C4 \uC5EC\uAE30\uC11C \uCC38 \uB9CE\uC774 \uB118\uC5B4\uC84C\uC5B4.\n\uB2E4\uC2DC
    \uC77C\uC5B4\uB098\uBA74 \uB418\uB294 \uAC70\uC57C."
  - "\uC815\uB839: \uAE09\uD560 \uAC83 \uC5C6\uC5B4. \uAC80\uC774 \uC624\uAE30 \uC804\uC5D0
    \uBE5B\uC774 \uBCF4\uC600\uC9C0?\n\uC774\uBC88\uC5D4 \uADF8 \uC21C\uAC04\uC744
    \uAE30\uB2E4\uB824\uBCF4\uC790."
  instructorGreeting: "\uAD50\uAD00: \uC11C\uB450\uB974\uC9C0 \uB9C8\uB77C. \uD798\uC774
    \uC5B4\uB514\uB85C \uD750\uB974\uB294\uC9C0 \uBA3C\uC800 \uC77D\uC5B4\uB77C."
  instructorReward: "\uAD50\uAD00: \uC774\uC81C \uCC98\uC74C\uC758 \uB9DD\uC124\uC784\uC740
    \uB35C\uC5C8\uAD70. \uC774 \uCC45\uC744 \uBC1B\uC544\uB77C.\n\n\uC8FC\uC778\uACF5:
    \u2026\uBC29\uAE08\uC740, \uB0B4 \uC190\uC73C\uB85C \uD574\uB0C8\uB2E4."
